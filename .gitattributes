# 换行策略：仓库内统一 LF，检出时按平台/类型还原。
# .bat 必须 CRLF —— cmd.exe 对 LF-only 批处理的标签/goto 解析不可靠。
* text=auto

*.bat   text eol=crlf
*.iss   text eol=crlf
*.isl   text eol=crlf
*.py    text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.json  text eol=lf
*.ini   text eol=lf

*.png   binary
*.ico   binary
*.exe   binary
